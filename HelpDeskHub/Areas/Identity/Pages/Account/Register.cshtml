@page
@model HelpDeskHub.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
}

<h2>Test Simple Form</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div>
        <label>Email:</label>
        <input type="text" name="Input.Email" placeholder="test@example.com" />
    </div>

    <div>
        <label>Password:</label>
        <input type="password" name="Input.Password" placeholder="password" />
    </div>

    <div>
        <label>Confirm Password:</label>
        <input type="password" name="Input.ConfirmPassword" placeholder="password" />
    </div>

    <button type="submit">Register</button>
</form>
