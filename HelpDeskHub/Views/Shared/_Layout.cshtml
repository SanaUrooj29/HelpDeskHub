<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HelpDeskHub</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/helpdesk.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    HelpDeskHub
                </a>

                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Main navigation -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Tickets"
                               asp-action="Index">
                                Tickets
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Tickets"
                                   asp-action="Create">
                                    Create Ticket
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Account / Identity navigation -->
                    <ul class="navbar-nav">

                        @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            <!-- Logged-in user -->
                            <li class="nav-item">
                                <span class="nav-link text-muted">
                                    @User.Identity?.Name
                                </span>
                            </li>

                            <!-- Account -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Manage">
                                    My Account
                                </a>
                            </li>

                            <!-- Support Agent -->
                            @if (User.IsInRole("SupportAgent"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Tickets"
                                       asp-action="AgentWorklist">
                                        My Assigned
                                    </a>
                                </li>
                            }

                            <!-- Administrator -->
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Admin
                                    </a>
                                </li>
                            }

                            <!-- Logout -->
                            <li class="nav-item">

                                <form method="post"
                                      asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      id="logoutForm">

                                    <button type="submit"
                                            class="nav-link btn btn-link text-dark">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Login
                                </a>
                            </li>

                            <!-- Register -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- Main content -->
    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted bg-light">

        <div class="container">
            &copy; 2026 - HelpDeskHub -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>

    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>